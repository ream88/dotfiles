// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "theme": "GitHub Dark Default",
  "diff_view_style": "unified",
  "tab_bar": {
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": false,
    "show": true
  },
  "title_bar": {
    "show_user_picture": true,
    "show_menus": false
  },
  "status_bar": {
    "show_active_file": false
  },
  "diagnostics": {
    "button": true
  },
  "rounded_selection": true,
  "cli_default_open_behavior": "new_window",
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "outline_panel": {
    "button": false,
    "dock": "right"
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "git_panel": {
    "dock": "left",
    "tree_view": false
  },
  "project_panel": {
    "dock": "left"
  },
  "allow_rewrap": "anywhere",
  "debugger": {
    "button": false
  },
  "minimap": {
    "show": "always"
  },
  "vim_mode": false,
  "show_edit_predictions": false,
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "ssh_connections": [
    {
      "host": "docker.local",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/pi"
          ]
        }
      ]
    },
    {
      "host": "pi.local",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/pi"
          ]
        }
      ]
    }
  ],
  "agent": {
    "button": false,
    "sidebar_side": "right",
    "dock": "right",
    "tool_permissions": {
      "default": "allow"
    },
    "play_sound_when_agent_done": "always",
    "profiles": {
      "write": {
        "name": "Write",
        "tools": {
          "search_web": true,
          "open": true,
          "create_directory": true,
          "batch_tool": true,
          "code_actions": true,
          "code_symbols": true,
          "contents": true,
          "copy_path": true,
          "create_file": true,
          "delete_path": true,
          "diagnostics": true,
          "edit_file": true,
          "fetch": true,
          "list_directory": true,
          "move_path": true,
          "now": true,
          "find_path": true,
          "read_file": true,
          "grep": true,
          "rename": true,
          "symbol_info": true,
          "terminal": true,
          "thinking": true
        },
        "enable_all_context_servers": true,
        "context_servers": {
          "Tidewave": {
            "tools": {
              "trace_process": true,
              "project_eval": true,
              "package_search": true,
              "package_docs_search": true,
              "get_source_location": true,
              "get_process_info": true,
              "get_logs": true,
              "get_ecto_schemas": true,
              "execute_sql_query": true,
              "list_liveview_pages": true
            }
          }
        }
      }
    },
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "anthropic",
      "model": "claude-opus-4-7-latest"
    },
  },
  "file_scan_exclusions": [
    ".elixir-tools",
    ".elixir_ls",
    ".expert",
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/deps",
    "**/node_modules"
  ],
  "buffer_font_size": 18,
  "buffer_font_family": "Fira Code",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "show_whitespaces": "all",
  "tab_size": 2,
  "formatter": "language_server",
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "ui_font_family": "Fira Code",
  "terminal": {
    "button": true
  },
  "collaboration_panel": {
    "dock": "right",
    "button": false
  },
  "lsp": {
    "expert": {
      "binary": {
        "arguments": [
          "--stdio"
        ]
      }
    }
  },
  "languages": {
    "Elixir": {
      "language_servers": [
        "expert",
        "!elixir-ls",
        "!next-ls",
        "!lexical",
        "tailwindcss-language-server",
        "emmet-language-server"
      ]
    },
    "Shell Script": {
      "format_on_save": "off",
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": [
            "-i",
            "4"
          ]
        }
      }
    }
  },
  "preferred_line_length": 100
}
